    {
      "id": "greeting",
      "match": "greeting",
      "keywords": ["hey", "hi", "hello", "good morning", "good afternoon", "good evening"],
      "replies": [
        "Hey {name}. How are you?",
        "Hi {name}. How is your day going?",
        "Hello {name}. Nice to see you."
      ],
      "follow_ups": [
        "What are you doing today?",
        "Feeling good, tired, or busy?",
        "Want a question?"
      ]
    },
    {
      "id": "how_are_you",
      "match": "contains",
      "keywords": ["how are you", "how's it going", "how are u", "how do you feel"],
      "replies": [
